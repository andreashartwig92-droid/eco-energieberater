# Kopieren nach .env (neben docker-compose.yml) oder /etc/eco-assistent.env (systemd).
# NIEMALS ins Git einchecken.

# Pflicht: API-Schlüssel von https://platform.claude.com (Console → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Pflicht, sobald der Server nicht nur auf 127.0.0.1 hört: Zugangspasswort für die Oberfläche
KI_PASSWORT=bitte-aendern

# Netzwerk. Im Docker-Container 0.0.0.0, hinter nginx auf dem Server 127.0.0.1.
KI_HOST=0.0.0.0
KI_PORT=8080

# Modell und Denktiefe (low | medium | high | xhigh | max). medium ist für Beratungsgespräche ein guter Start.
KI_MODELL=claude-opus-5-5
KI_EFFORT=medium
KI_MAX_TOKENS=16000

# Server-seitiger Fallback auf ein anderes Claude-Modell, wenn ein Sicherheitsfilter ablehnt (Beta). 1 = an
KI_FALLBACK=1

# Anfragen pro Stunde und Client-IP (0 = kein Limit)
KI_LIMIT_PRO_STUNDE=60
# 1, wenn ein Reverse-Proxy davor steht und X-Forwarded-For gesetzt wird
KI_VERTRAUE_PROXY=0

# Anzeigename, Wissensordner, Ablage für erzeugte Berichte
KI_NAME=eco Energieberater-KI
KI_WISSEN=/app/wissen
KI_BERICHTE=/app/berichte
