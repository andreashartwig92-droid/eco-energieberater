# Kopieren nach deploy/.env (Docker) oder /etc/eco-assistent.env (systemd). NIEMALS ins Git einchecken.

# ---- Betriebsart --------------------------------------------------------------
# lokal  = eigenes Open-Source-Modell auf dem eigenen Server über Ollama (Standard, keine fremde API)
# claude = Claude-API von Anthropic (braucht ANTHROPIC_API_KEY)
KI_BACKEND=lokal

# Modell. Lokal: Name wie bei `ollama pull`. Empfehlung ab 8 GB RAM/VRAM: qwen3:8b.
# Alternativen: llama3.1:8b, qwen3:14b (ab 12 GB), qwen3:32b oder mistral-small (ab 24 GB, GPU).
KI_MODELL=qwen3:8b

# Pflicht, sobald der Server nicht nur auf 127.0.0.1 hört: Zugangspasswort für die Oberfläche
KI_PASSWORT=bitte-aendern

# Netzwerk. Im Docker-Container 0.0.0.0, hinter nginx auf dem Server 127.0.0.1.
KI_HOST=0.0.0.0
KI_PORT=8080

# ---- Nur lokal (Ollama) --------------------------------------------------------
# Adresse von Ollama. In docker-compose: http://ollama:11434, auf dem Server direkt: http://127.0.0.1:11434
KI_OLLAMA_URL=http://ollama:11434
# Kontextfenster in Token (Wissensbasis + Werkzeuge + Gespräch müssen hineinpassen). Mehr = mehr RAM.
KI_NUM_CTX=16384
# Denkmodus des Modells (qwen3 u. a.): aus = schneller, an = gründlicher, auto = Modellstandard
KI_DENKEN=aus
# Wie lange das Modell nach einer Antwort im Speicher bleibt (schnellere Folgeantworten)
KI_KEEP_ALIVE=30m
# Zeitlimit je Antwort in Sekunden (CPU ohne GPU ist langsam)
KI_ZEITLIMIT=600

# ---- Nur Claude ----------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# KI_EFFORT=medium          # low | medium | high | xhigh | max
# KI_FALLBACK=1             # server-seitiger Fallback bei Sicherheitsablehnungen (Beta)

# ---- Allgemein -------------------------------------------------------------------
KI_MAX_TOKENS=16000
KI_LIMIT_PRO_STUNDE=60
KI_VERTRAUE_PROXY=0
KI_NAME=eco Energieberater-KI
KI_WISSEN=/app/wissen
KI_BERICHTE=/app/berichte

# ---- Bilanz-Radar (interne Auswertung von Jahresabschlüssen, Dienst "bilanzen") ---------------
# Pflicht, sobald BILANZ_HOST nicht 127.0.0.1 ist. Nur intern freigeben – das Werkzeug ist nicht für Kunden gedacht.
BILANZ_PASSWORT=bitte-aendern
BILANZ_HOST=0.0.0.0
BILANZ_PORT=8081
BILANZ_DATENBANK=/app/daten/bilanzen.sqlite
# Sekunden zwischen zwei Anfragen an den Bundesanzeiger (mindestens 1, Standard 2)
BILANZ_PAUSE=2
# Trefferseiten je Suchbegriff als Vorgabe in der Oberfläche (20 Treffer je Seite, 0 = alle)
BILANZ_MAX_SEITEN=5
BILANZ_VERTRAUE_PROXY=0
# Chromium für die Quelle Unternehmensregister (im Docker-Image /usr/bin/chromium; leer = von `playwright install chromium`)
BILANZ_CHROMIUM=/usr/bin/chromium
