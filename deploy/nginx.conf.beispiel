# Reverse-Proxy mit HTTPS (Zertifikat z. B. per certbot). Ersetzt ki.example.de durch Ihre Domain.
server {
    listen 443 ssl http2;
    server_name ki.example.de;

    ssl_certificate     /etc/letsencrypt/live/ki.example.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ki.example.de/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming-Antworten (Server-Sent Events) nicht puffern
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }
}

server {
    listen 80;
    server_name ki.example.de;
    return 301 https://$host$request_uri;
}
